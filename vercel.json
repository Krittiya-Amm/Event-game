{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "",
  "outputDirectory": "public",
  "cleanUrls": true,
  "regions": ["sin1"],
  "rewrites": [{ "source": "/api/:path*", "destination": "/api/index" }],
  "functions": { "api/index.js": { "maxDuration": 15 } },
  "headers": [
    { "source": "/api/(.*)", "headers": [{ "key": "Cache-Control", "value": "no-store" }] }
  ]
}
