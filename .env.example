PORT=3000
DB_FILE=data/event.db
# Public base URL (used in QR codes + LINE push). Leave empty to use the request host.
PUBLIC_URL=

# Backoffice login (one account) and Staff PIN — CHANGE before the event.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-admin
STAFF_PIN=change-me-staff

# LINE Login / LIFF (from LINE Developers console)
LIFF_ID=
LINE_LOGIN_CHANNEL_ID=
# Optional: Messaging API channel access token to push the result to the player
LINE_CHANNEL_ACCESS_TOKEN=

# Web entry (User Flow: scan QR → web). 1 = play in any browser without LINE login (default). 0 = LINE (LIFF) only.
WEB_PLAY=1

# ---- Supabase (production / Vercel) — leave empty to use the local SQLite file ----
# Supabase → Connect → "Transaction pooler" (port 6543), with your database password filled in
DATABASE_URL=
# Supabase → Project Settings → API
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
